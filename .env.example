# Stellar testnet RPC (no secretos reales en el repo)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Clave secreta del relayer que patrocina comisiones (solo variables de entorno, nunca commitear)
RELAYER_SECRET=

# Cuenta emisora del activo de prueba tUSDC en testnet (solo variables de entorno, nunca commitear)
ISSUER_SECRET=

# Direcciones públicas del despliegue en testnet (se llenan tras pnpm setup:testnet)
CONTRACT_ID=
TUSDC_CONTRACT_ID=
TUSDC_ISSUER=

# URL de la app desplegada (opcional)
APP_URL=
